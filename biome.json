{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "src/**/*.js",
      "src/**/*.d.ts",
      "src/**/*.css",
      "scripts/**/*.mjs",
      "tests/**/*.mjs",
      "media-formats.json",
      "package.json",
      "tsconfig.json",
      "biome.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noPrototypeBuiltins": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  }
}
