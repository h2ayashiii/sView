{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sView",
  "version": "0.1.0",
  "identifier": "io.github.h2ayashiii.sview",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "sView",
        "width": 960,
        "height": 640,
        "minWidth": 200,
        "minHeight": 150,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "title": "sView の設定",
        "url": "settings.html",
        "width": 470,
        "height": 560,
        "minWidth": 380,
        "minHeight": 300,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Photography",
    "shortDescription": "Minimal frameless image viewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES": "THIRD-PARTY-NOTICES"
    },
    "fileAssociations": [
      {
        "ext": ["avif", "bmp", "gif", "ico", "jfif", "jpe", "jpeg", "jpg", "png", "svg", "tif", "tiff", "webp"],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer"
      },
      {
        "ext": ["cbz"],
        "name": "Comic Book Archive",
        "description": "Comic book archive (zip). sView can also open .zip, but .zip is deliberately left unassociated to avoid taking it from archivers",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
